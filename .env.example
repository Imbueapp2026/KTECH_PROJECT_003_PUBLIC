# Public Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=placeholder-anon-key
SUPABASE_SECRET_KEY=placeholder-service-role-key
SUPABASE_JWKS_URL=https://placeholder.supabase.co/auth/v1/.well-known/jwks.json

# Firebase service-account variables configured by the deployment environment
FIREBASE_PROJECT_ID=placeholder-project-id
FIREBASE_CLIENT_EMAIL=placeholder-service-account@example.com
FIREBASE_SERVICE_ACCOUNT_KEY=placeholder-base64-service-account-json

# Storage URL (optional)
NEXT_PUBLIC_STORAGE_URL=https://placeholder.supabase.co/storage/v1/object/public

# Public site URL (optional)
NEXT_PUBLIC_SITE_URL=https://example.com
